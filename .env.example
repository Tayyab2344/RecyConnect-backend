# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (PostgreSQL via Neon) ─────────────────────────────
# Use the -pooler endpoint for application queries
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/dbname?sslmode=require&connection_limit=10&pool_timeout=30"
# Use the NON-pooler endpoint for Prisma migrations only
DIRECT_DATABASE_URL="postgresql://user:password@endpoint.region.neon.tech/dbname?sslmode=require"

# ── Redis (Upstash) ───────────────────────────────────────────
REDIS_URL="rediss://default:password@host.upstash.io:6379"

# ── Authentication ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_SALT_ROUNDS=10

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="RecyConnect <your-email@gmail.com>"

# ── Cloudinary (Image Uploads) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── OTP ───────────────────────────────────────────────────────
OTP_TTL_MINUTES=15

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# ── Stripe Payments ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_CURRENCY=pkr

# ── Document Encryption ──────────────────────────────────────
DOCUMENT_ENCRYPTION_KEY=your-32-char-hex-key

# ── AI Services ──────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# ── Kafka (Confluent Cloud) ──────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=your-cluster.confluent.cloud:9092
KAFKA_API_KEY=your-kafka-key
KAFKA_API_SECRET=your-kafka-secret
KAFKA_TOPIC=recyconnect-events
KAFKA_CONSUMER_GROUP=recyconnect-backend-group

# ── Render Hosting ───────────────────────────────────────────
# Set to 'true' only if using Render free tier (enables keep-alive pings)
# RENDER_FREE_TIER=false
# PUBLIC_URL=https://your-app.onrender.com

# ── Pusher Channels ───────────────────────────────────────────
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap2

