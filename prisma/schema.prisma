generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  RESERVED
  SOLD
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  COMPLETED
  CANCELLED
  PENDING
  CONFIRMED
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  WAITING_FOR_DISPATCH
  WAREHOUSE_ASSIGNED
  COLLECTOR_ASSIGNED
  COLLECTOR_ACCEPTED
  TRAVELLING_TO_SELLER
  ARRIVED_AT_PICKUP
  MATERIAL_VERIFIED
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_BUYER
  BUYER_VERIFICATION
  DELIVERED
  COMPLETED
  CANCELLED
  WAREHOUSE_REJECTED
  COLLECTOR_DECLINED
  BUYER_CANCELLED
  SELLER_CANCELLED
  DELIVERY_FAILED
  REFUND_INITIATED
  CREATED
  PROCESSING
  SHIPPED
}

enum DeliveryMethod {
  SELF_TRANSPORTATION
  WAREHOUSE_COLLECTOR_SERVICE
  INDEPENDENT_COLLECTOR_SERVICE
  SELF_DELIVERY
  BUYER_PICKUP
  RECYCONNECT_PICKUP
}

enum CollectorType {
  WAREHOUSE
  INDEPENDENT
}

enum TripStatus {
  DRAFT
  PENDING_DISPATCH
  ASSIGNED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  RELEASED
  REFUNDED
  FAILED
  PENDING // Legacy
  COMPLETED // Legacy
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CollectorAvailability {
  OFFLINE
  ONLINE
  ON_DUTY
  BUSY
  BREAK
}

enum CollectorTaskType {
  SELLER_TO_WAREHOUSE
  SELLER_TO_BUYER
  WAREHOUSE_TO_BUYER
  BUYER_REQUESTED_PICKUP
  SELF_DELIVERY
}

enum CollectorTaskStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE_TO_PICKUP
  ARRIVED_AT_SOURCE
  VERIFIED
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  DELIVERED
  COMPLETED
  CANCELLED
  REJECTED
}

enum WasteVerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
  REJECTED
}

enum CollectorDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String?   @unique
  password      String?
  role          String
  businessName  String?
  companyName   String?
  collectorId   String?   @unique
  profileImage  String?
  address       String?
  contactNo     String?
  emailVerified Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  createdById   Int?
  createdBy     User?     @relation("creator", fields: [createdById], references: [id])
  createdUsers  User[]    @relation("creator")

  verificationStatus  String  @default("PENDING")
  kycStage            String  @default("REGISTERED")
  assignedWarehouseId Int?
  permissions         Json?
  rejectionReason     String?
  requestedRole       String?
  cnic                String? @unique

  latitude           Float?
  longitude          Float?
  city               String?
  area               String?
  locationMethod     String? // "auto" or "manual"
  locationPermission Boolean   @default(false)
  addressUpdatedAt   DateTime?
  fcmToken           String?

  // Warehouse Business Profile Fields
  stripeAccountId   String? // Stripe Connected Account ID
  businessLicense   String? // Business license number
  taxNumber         String? // Tax registration number
  warehouseCapacity Float? // Total warehouse capacity in kg
  operatingHours    Json? // Business operating hours
  deliveryRadius           Float?              @default(10.0) // Service delivery radius in km
  acceptsDispatchOrders    Boolean             @default(true)
  dispatchStatus           String              @default("ACTIVE")
  currentActiveDispatches  Int                 @default(0)
  averageDispatchRating    Float?
  dispatchesWarehouse      Dispatch[]          @relation("DispatchWarehouse")
  dispatchesCollector      Dispatch[]          @relation("DispatchCollector")

  otps              Otp[]
  documents         UserDocument[]
  ocrDatas          OcrData[]
  refreshTokens     RefreshToken[]
  activityLogs      ActivityLog[]        @relation("actorLogs")
  items             Item[]
  listings          Listing[]
  buyerOrders       Order[]              @relation("BuyerOrders")
  sellerOrders      Order[]              @relation("SellerOrders")
  buyerReservations ListingReservation[] @relation("BuyerReservations")

  // Chat Relations
  conversations1 Conversation[] @relation("Participant1")
  conversations2 Conversation[] @relation("Participant2")
  sentMessages   Message[]      @relation("SentMessages")

  // Warehouse ERP Relations
  warehouseInventory    WarehouseInventory[]   @relation("WarehouseInventory")
  suppliedInventory     WarehouseInventory[]   @relation("SupplierInventory")
  expenses              Expense[]
  financialTransactions FinancialTransaction[]
  inventoryMovements    InventoryMovement[]

  // Transaction Relations
  buyerTransactions  Transaction[] @relation("BuyerTransactions")
  sellerTransactions Transaction[] @relation("SellerTransactions")

  // Complaint Relations
  complaints                Complaint[]
  collectorProfile          CollectorProfile?   @relation("CollectorProfileUser")
  managedCollectorProfiles  CollectorProfile[]  @relation("CollectorProfileWarehouse")
  assignedCollectorTasks    CollectorTask[]     @relation("TaskCollector")
  warehouseCollectorTasks   CollectorTask[]     @relation("TaskWarehouse")
  sourceCollectorTasks      CollectorTask[]     @relation("TaskSourceUser")
  destinationCollectorTasks CollectorTask[]     @relation("TaskDestinationUser")
  warehouseTrips            Trip[]              @relation("WarehouseTrips")
  collectorTrips            Trip[]              @relation("CollectorTrips")
  wasteVerifications        WasteVerification[] @relation("WasteVerificationCollector")
  collectorDeliveries       CollectorDelivery[] @relation("CollectorDeliveryCollector")
  collectorLocations        CollectorLocation[] @relation("CollectorLocationCollector")
  collectorIncidents        CollectorIncident[] @relation("CollectorIncidentUser")
  collectorEarnings         CollectorEarning[]  @relation("CollectorEarningUser")
  notifications             Notification[]
  ecoPoints                 Int                 @default(0)
  currentLevel              String              @default("Beginner Recycler")
  dailyStreak               Int                 @default(0)
  lastLoginDate             DateTime?
  referredById              Int?
  referredBy                User?               @relation("Referral", fields: [referredById], references: [id])
  referrals                 User[]              @relation("Referral")
  rewards                   Reward[]            @relation("UserRewards")
  badges                    Badge[]             @relation("UserBadges")
  leaderboard               Leaderboard?        @relation("UserLeaderboard")
  reviewsGiven              Review[]            @relation("ReviewsGiven")
  reviewsReceived           Review[]            @relation("ReviewsReceived")

  @@index([role])
  @@index([contactNo])
  @@index([verificationStatus])
  @@index([city, area])
}

model UserDocument {
  id                   Int      @id @default(autoincrement())
  user                 User     @relation(fields: [userId], references: [id])
  userId               Int
  docType              String
  fileUrl              String
  fileName             String?
  encrypted            Boolean  @default(false)
  encryptionAlgorithm  String?
  encryptionIv         String?
  encryptionAuthTag    String?
  encryptionKeyVersion String?
  mimeType             String?
  fileSize             Int?
  createdAt            DateTime @default(now())

  @@index([userId])
}

model OcrData {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  docType       String
  ocrText       String
  fileUrl       String
  extractedData Json?
  isMatch       Boolean  @default(false)
  confidence    Float?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  otpHash   String
  purpose   String
  metadata  Json? // Store registration data before user creation
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  tokenHash String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  actorRole    String?
  action       String
  resourceType String?
  resourceId   String?
  meta         Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("actorLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String // info, warn, error
  type      String // API, DATABASE, ERROR, SYSTEM
  message   String
  metadata  Json? // Detailed tracking data (stack trace, path, execution time)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([type])
  @@index([createdAt])
}

model Item {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  seller      User     @relation(fields: [sellerId], references: [id])
  title       String
  description String?
  price       Float
  quantity    Float // In kg or units
  unit        String   @default("kg")
  category    String
  images      String[]
  status      String   @default("AVAILABLE") // AVAILABLE, SOLD, REMOVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@index([status])
  @@index([category])
  @@index([sellerId, status])
}

model Rate {
  id           Int      @id @default(autoincrement())
  category     String   @unique
  pricePerUnit Float
  unit         String   @default("kg")
  updatedAt    DateTime @updatedAt
}

model Listing {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  category        String // Category of items (e.g., Plastic, Metal)
  title           String? // Optional title
  description     String? // Optional description
  materialType    String // plastic, paper, metal, e-waste
  estimatedWeight Float // in kg, max 10kg for individuals
  price           Float         @default(0.0) // Price per kg or total price
  quantity        Float         @default(1.0) // Quantity available
  pickupAddress   String?
  images          String[] // Array of image URLs or base64 strings
  latitude        Float?
  longitude       Float?
  city            String? // Denormalized from user
  area            String? // Denormalized from user
  locationMethod  String? // "auto" or "manual"
  notes           String?
  status          ListingStatus @default(DRAFT)
  metadata        Json? // Flexible JSON metadata 

  reservations ListingReservation[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([price])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, status, createdAt])
  @@index([materialType])
  @@index([materialType, status, createdAt])
  @@index([userId])
  @@index([materialType, status, city])
}

model ListingReservation {
  id        Int               @id @default(autoincrement())
  listingId Int
  listing   Listing           @relation(fields: [listingId], references: [id])
  buyerId   Int
  buyer     User              @relation("BuyerReservations", fields: [buyerId], references: [id])
  orderId   Int?              @unique // Reservation must reference an order if it proceeds
  order     Order?            @relation(fields: [orderId], references: [id])
  quantity  Float // Quantity reserved
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model Order {
  id       Int  @id @default(autoincrement())
  buyerId  Int
  buyer    User @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId Int
  seller   User @relation("SellerOrders", fields: [sellerId], references: [id])

  status         OrderStatus    @default(PENDING)
  totalAmount    Float          @default(0.0)
  paymentMethod  String? // 'cod' or 'stripe'
  deliveryMethod DeliveryMethod @default(SELF_TRANSPORTATION)
  handshakeOtp   String?

  collectorTasks CollectorTask[]

  // Link to reservation
  reservation ListingReservation?

  // Items in this order
  items OrderItem[]

  // Payment for this order
  payment Payment?
  dispatch Dispatch?

  // Reviews for this order
  reviews Review[]

  // Legacy/Financial Tracking Fields
  cogs            Float? // Cost of Goods Sold
  stripeFee       Float? // Stripe processing fee
  collectorCost   Float? // Cost paid to collector
  netProfit       Float? // totalAmount - costs
  stripePaymentId String? // Stripe payment intent ID
  metadata        Json? // Flexible tracking details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // financialTransactions FinancialTransaction[]
  financialTransactions FinancialTransaction[]

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([createdAt])
  @@index([buyerId, status])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status])
  @@index([sellerId, status, createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id])
  quantity  Float // Checked by application logic (no negative)
  price     Float // At time of purchase

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([listingId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int           @unique // one order -> one payment
  order           Order         @relation(fields: [orderId], references: [id])
  amount          Float
  currency        String        @default("PKR")
  provider        String        @default("STRIPE") // STRIPE, COD
  paymentMethod   String? // card, bank_transfer, etc.
  status          PaymentStatus @default(INITIATED)
  paymentIntentId String?       @unique // Stripe PaymentIntent ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, createdAt])
  @@index([orderId])
}

model CollectorProfile {
  id                 Int                   @id @default(autoincrement())
  userId             Int                   @unique
  user               User                  @relation("CollectorProfileUser", fields: [userId], references: [id])
  warehouseId        Int?
  warehouse          User?                 @relation("CollectorProfileWarehouse", fields: [warehouseId], references: [id])
  collectorType      CollectorType         @default(WAREHOUSE)
  employeeId         String                @unique
  availabilityStatus CollectorAvailability @default(OFFLINE)
  dutyStatus         String                @default("OFF_DUTY")
  vehicleInfo        Json?
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationAt     DateTime?
  lastActiveAt       DateTime?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  totalActiveMinutes Int                   @default(0)
  completedTasks     Int                   @default(0)
  cancelledTasks     Int                   @default(0)
  totalCollectedKg   Float                 @default(0)
  reliabilityScore   Float                 @default(100)
  rating             Float?
  suspendedAt        DateTime?
  onlineStatus       Boolean               @default(false)
  activeOrdersCount  Int                   @default(0)
  vehicleType        String?               @default("MOTORCYCLE")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([warehouseId])
  @@index([availabilityStatus])
}

model Trip {
  id             Int             @id @default(autoincrement())
  warehouseId    Int
  warehouse      User            @relation("WarehouseTrips", fields: [warehouseId], references: [id])
  collectorId    Int?
  collector      User?           @relation("CollectorTrips", fields: [collectorId], references: [id])
  status         TripStatus      @default(DRAFT)
  optimizedPath  Json?           // Array of coordinates or segments
  totalDistance  Float?          // in km
  totalDuration  Float?          // in seconds
  tasks          CollectorTask[] // Collector tasks grouped under this trip
  conversations  Conversation[]  // Conversations tied to this trip

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([warehouseId])
  @@index([collectorId])
  @@index([status])
}

model CollectorTask {
  id                   Int                 @id @default(autoincrement())
  warehouseId          Int?
  warehouse            User?               @relation("TaskWarehouse", fields: [warehouseId], references: [id])
  collectorId          Int?
  collector            User?               @relation("TaskCollector", fields: [collectorId], references: [id])
  tripId               Int?
  trip                 Trip?               @relation(fields: [tripId], references: [id])
  sequenceIndex        Int?
  orderId              Int?
  order                Order?              @relation(fields: [orderId], references: [id])
  taskType             CollectorTaskType
  status               CollectorTaskStatus @default(ASSIGNED)
  priority             String              @default("NORMAL")
  sourceType           String
  sourceUserId         Int?
  sourceUser           User?               @relation("TaskSourceUser", fields: [sourceUserId], references: [id])
  sourceName           String?
  sourceAddress        String
  sourceContact        String?
  sourceLatitude       Float?
  sourceLongitude      Float?
  destinationType      String
  destinationUserId    Int?
  destinationUser      User?               @relation("TaskDestinationUser", fields: [destinationUserId], references: [id])
  destinationName      String?
  destinationAddress   String
  destinationContact   String?
  destinationLatitude  Float?
  destinationLongitude Float?
  materialCategory     String
  materialType         String?
  estimatedWeight      Float
  unit                 String              @default("kg")
  listedPrice          Float?
  pricePerUnit         Float?
  deliveryFee          Float?
  estimatedValue       Float?
  finalValue           Float?
  images               String[]
  notes                String?
  instructions         String?
  routeInfo            Json?
  metadata             Json?
  acceptedAt           DateTime?
  pickupStartedAt      DateTime?
  arrivedAtSourceAt    DateTime?
  pickedUpAt           DateTime?
  transitStartedAt     DateTime?
  arrivedDestinationAt DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  verification WasteVerification?
  delivery     CollectorDelivery?
  locations    CollectorLocation[]
  otpCode      String?
  incidents    CollectorIncident[]
  earning      CollectorEarning?

  @@index([warehouseId, status])
  @@index([collectorId, status])
  @@index([taskType])
  @@index([createdAt])
}

model WasteVerification {
  id               Int                     @id @default(autoincrement())
  taskId           Int                     @unique
  task             CollectorTask           @relation(fields: [taskId], references: [id])
  listedWeight     Float
  verifiedWeight   Float
  listedCategory   String
  verifiedCategory String
  verifiedMaterial String?
  proofImages      String[]
  notes            String?
  status           WasteVerificationStatus @default(VERIFIED)
  weightDifference Float
  priceBefore      Float?
  priceAfter       Float?
  verifiedById     Int
  verifiedBy       User                    @relation("WasteVerificationCollector", fields: [verifiedById], references: [id])
  verifiedAt       DateTime                @default(now())

  @@index([verifiedById])
  @@index([status])
}

model CollectorDelivery {
  id                   Int                     @id @default(autoincrement())
  taskId               Int                     @unique
  task                 CollectorTask           @relation(fields: [taskId], references: [id])
  status               CollectorDeliveryStatus @default(DELIVERED)
  receiverName         String?
  receiverContact      String?
  receiverConfirmation String?
  receivedWeight       Float?
  packageCondition     String?
  proofImages          String[]
  notes                String?
  deliveredById        Int
  deliveredBy          User                    @relation("CollectorDeliveryCollector", fields: [deliveredById], references: [id])
  deliveredAt          DateTime                @default(now())

  @@index([deliveredById])
  @@index([status])
}

model CollectorLocation {
  id          Int            @id @default(autoincrement())
  taskId      Int?
  task        CollectorTask? @relation(fields: [taskId], references: [id])
  collectorId Int
  collector   User           @relation("CollectorLocationCollector", fields: [collectorId], references: [id])
  latitude    Float
  longitude   Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  status      String?
  createdAt   DateTime       @default(now())

  @@index([collectorId, createdAt])
  @@index([taskId, createdAt])
}

// ========================================
// WAREHOUSE ERP MODELS
// ========================================

model WarehouseInventory {
  id              Int      @id @default(autoincrement())
  warehouseId     Int
  warehouse       User     @relation("WarehouseInventory", fields: [warehouseId], references: [id])
  materialType    String // plastic, paper, metal, e-waste, glass
  category        String // AI-classified detailed category
  quantityInStock Float // current stock in kg
  reorderLevel    Float? // alert threshold
  purchasePrice   Float // cost per kg when acquired
  sellingPrice    Float // expected selling price per kg
  supplierId      Int? // who sold this to warehouse
  supplier        User?    @relation("SupplierInventory", fields: [supplierId], references: [id])
  location        String? // bin/zone in warehouse
  notes           String? // additional notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements InventoryMovement[]

  @@index([warehouseId, materialType])
  @@index([warehouseId, quantityInStock])
}

model InventoryMovement {
  id          Int                @id @default(autoincrement())
  inventoryId Int
  inventory   WarehouseInventory @relation(fields: [inventoryId], references: [id])
  type        String // INFLOW, OUTFLOW, ADJUSTMENT, LOSS
  quantity    Float // in kg (positive for INFLOW, negative for OUTFLOW)
  reference   String? // order ID, supplier invoice, etc.
  notes       String?
  performedBy Int
  user        User               @relation(fields: [performedBy], references: [id])
  createdAt   DateTime           @default(now())

  @@index([inventoryId, createdAt])
}

model Expense {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   User     @relation(fields: [warehouseId], references: [id])
  category    String // OPERATIONAL, EMPLOYEE, TRANSPORTATION, RENT, UTILITIES, PACKAGING, COLLECTOR
  amount      Float
  description String?
  date        DateTime
  receipt     String? // cloudinary URL for receipt image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([warehouseId, date])
  @@index([warehouseId, category])
}

model FinancialTransaction {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   User     @relation(fields: [warehouseId], references: [id])
  type        String // REVENUE, EXPENSE, REFUND
  amount      Float
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  description String?
  stripeFee   Float? // Stripe processing fee if applicable
  netAmount   Float // amount - stripeFee (for revenue) or just amount (for expense)
  metadata    Json? // Additional data (material type, customer info, etc.)
  createdAt   DateTime @default(now())

  @@index([warehouseId, type, createdAt])
  @@index([warehouseId, createdAt])
}

model CollectorIncident {
  id          Int            @id @default(autoincrement())
  taskId      Int?
  task        CollectorTask? @relation(fields: [taskId], references: [id])
  collectorId Int
  collector   User           @relation("CollectorIncidentUser", fields: [collectorId], references: [id])
  type        String // e.g., blocked route, customer unavailable, danger
  description String
  proofImage  String?
  status      String         @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime       @default(now())
}

model CollectorEarning {
  id          Int           @id @default(autoincrement())
  taskId      Int           @unique
  task        CollectorTask @relation(fields: [taskId], references: [id])
  collectorId Int
  collector   User          @relation("CollectorEarningUser", fields: [collectorId], references: [id])
  amount      Float
  distance    Float?
  status      String        @default("PENDING") // PENDING, PAID
  createdAt   DateTime      @default(now())
}

model Conversation {
  id             Int       @id @default(autoincrement())
  participant1Id Int
  participant1   User      @relation("Participant1", fields: [participant1Id], references: [id])
  participant2Id Int
  participant2   User      @relation("Participant2", fields: [participant2Id], references: [id])
  orderId        Int? // Links conversation to an order context
  tripId         Int? // Links conversation to a trip context
  trip           Trip?     @relation(fields: [tripId], references: [id])
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED
  type           String    @default("GENERAL") // GENERAL, BUYER_SELLER, BUYER_COLLECTOR
  messages       Message[]
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([orderId])
  @@index([type])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  imageUrl       String?
  messageType    String       @default("TEXT") // TEXT, IMAGE, VOICE_NOTE, SYSTEM, CALL_LOG
  voiceUrl       String? // URL for voice note recordings
  callDuration   Int? // Duration in seconds for call logs
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([messageType])
}

model Transaction {
  id          Int               @id @default(autoincrement())
  buyerId     Int
  buyer       User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId    Int
  seller      User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  itemId      Int
  item        Item              @relation(fields: [itemId], references: [id])
  quantity    Float
  totalAmount Float
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([buyerId])
  @@index([buyerId, status])
  @@index([sellerId])
  @@index([sellerId, status])
  @@index([itemId])
  @@index([status])
}

model Complaint {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  category    String // Pickup Issues, Order Issues, App Bugs, Payment Problem, etc.
  description String
  status      String    @default("PENDING") // PENDING, IN_REVIEW, RESOLVED, DISMISSED
  adminNotes  String? // Admin response/notes
  resolvedAt  DateTime?
  resolvedBy  Int? // Admin who resolved it
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // ORDER, PAYMENT, CHAT, PICKUP, AI, REWARD, SECURITY, SYSTEM, TRACKING
  priority  String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Reward {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("UserRewards", fields: [userId], references: [id], onDelete: Cascade)
  points       Int
  activityType String   // e.g. "LISTING_UPLOAD", "AI_CLASSIFICATION", "SUCCESSFUL_SALE", "PURCHASE", "DAILY_STREAK", "REFERRAL", "RATING", "CHALLENGE"
  rewardType   String   // "POINTS", "CASHBACK", "COUPON"
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Badge {
  id        Int      @id @default(autoincrement())
  userId    Int
  user         User     @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  badgeName String   // e.g. "First Sale Badge", "Eco Hero", "Trusted Seller", "Green Contributor", "Recycling Master"
  earnedAt  DateTime @default(now())

  @@index([userId])
}

model Leaderboard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user         User     @relation("UserLeaderboard", fields: [userId], references: [id], onDelete: Cascade)
  totalPoints Int      @default(0)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([totalPoints])
}

model Review {
  id                  Int      @id @default(autoincrement())
  orderId             Int
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId          Int
  reviewer            User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId          Int
  reviewee            User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating              Int      // 1 to 5 stars
  feedback            String?

  // Multi-category ratings
  productQuality      Int?     // 1 to 5 stars
  materialAccuracy    Int?     // 1 to 5 stars
  communication       Int?     // 1 to 5 stars
  deliveryExperience  Int?     // 1 to 5 stars
  overallSatisfaction Int?     // 1 to 5 stars

  // Anti-abuse & Reporting
  isReported          Boolean  @default(false)
  reportReason        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
}

model Dispatch {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  order             Order     @relation(fields: [orderId], references: [id])
  warehouseId       Int?
  warehouse         User?     @relation("DispatchWarehouse", fields: [warehouseId], references: [id])
  collectorId       Int?
  collector         User?     @relation("DispatchCollector", fields: [collectorId], references: [id])
  pickupLocation    String
  deliveryLocation  String
  estimatedDistance Float?
  estimatedDuration Float?
  deliveryFee       Float     @default(0.0)
  dispatchStatus    String    @default("PENDING_ACCEPTANCE") // PENDING_ACCEPTANCE, ACCEPTED, REJECTED, ASSIGNED, COMPLETED, CANCELLED
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

